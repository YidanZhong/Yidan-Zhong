+    "yellow towercrane": ("towercrane", "tower_crane", "crane"),
+    "cabling winches": ("winch", "cable", "cabling"),
+    "bio toilet": ("biotoilet", "bio_toilet", "toilet"),
+    "biotoilet": ("biotoilet", "bio_toilet", "toilet"),
