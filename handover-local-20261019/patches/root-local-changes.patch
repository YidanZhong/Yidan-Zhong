diff --git a/scripts/postprocess_terrain_tiles.py b/scripts/postprocess_terrain_tiles.py
new file mode 100644
index 0000000000000000000000000000000000000000..64ff8bee73130e6e06a4899966508ccbd5763db7
--- /dev/null
+++ b/scripts/postprocess_terrain_tiles.py
@@ -0,0 +1,234 @@
+"""Private diagnostic postprocessing of checksum-pinned real PhysX tiles."""
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+import gc
+import json
+import logging
+from pathlib import Path
+import shutil
+import sys
+import time
+import types
+from typing import Any
+
+import numpy as np
+from resumable_terrain_store import FIELDS, TileStore, atomic_json, dataset_lock, digest
+
+
+def stitch(store: TileStore, output: Path) -> tuple[dict[str, np.ndarray], dict[str, Any]]:
+    """Require complete committed coverage and verify every written core cell."""
+    if len(store.completed) != len(store.tiles):
+        raise ValueError('Incomplete dataset cannot produce a full map')
+    shape = tuple(store.contract['grid']['shape'])
+    output.mkdir(exist_ok=False)
+    arrays = {key: np.lib.format.open_memmap(output/f'{key}.npy', mode='w+', dtype=dtype,
+              shape=(*shape, 3) if key == 'normal' else shape) for key, dtype in FIELDS.items()}
+    coverage = np.zeros(shape, dtype=np.uint8)
+    for tile in store.tiles:
+        r0,r1,c0,c1 = tile['core']
+        core = (slice(r0,r1),slice(c0,c1))
+        with np.load(store.root/'tiles'/f'{tile["id"]}.npz', allow_pickle=False) as data:
+            for key in FIELDS:
+                arrays[key][core] = data[key]
+        coverage[core] += 1
+    if not np.all(coverage == 1):
+        raise ValueError('Missing or overlapping core cells')
+    del coverage
+    for value in arrays.values():
+        value.flush()
+    # Reopen disk files; compare independently of the in-memory write view.
+    arrays = {key:np.load(output/f'{key}.npy', mmap_mode='r') for key in FIELDS}
+    for tile in store.tiles:
+        r0,r1,c0,c1=tile['core']
+        with np.load(store.root/'tiles'/f'{tile["id"]}.npz', allow_pickle=False) as data:
+            for key in FIELDS:
+                if not np.array_equal(arrays[key][r0:r1,c0:c1],data[key]):
+                    raise ValueError(f'Disk stitch differs: {tile["id"]}/{key}')
+    return arrays, {'tiles':len(store.tiles),'cells':int(np.prod(shape)),
+                    'coverage_exactly_once':True,'all_8_fields_disk_readback_equal':True}
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    started=time.monotonic()
+    output=args.output
+    output.mkdir(parents=True,exist_ok=False)
+    def stage(name: str) -> None:
+        logging.info('POSTPROCESS_STAGE: %s',name)
+        atomic_json(output/'progress.json',{'stage':name,'elapsed_s':time.monotonic()-started})
+    stage('validate_sources_and_tiles')
+    contract=json.loads((args.dataset/'contract.json').read_text(encoding='utf-8'))
+    for relative, expected in contract['source_sha256'].items():
+        if relative.startswith('benchmark/'):
+            if digest(args.benchmark_package/relative[10:]) != expected:
+                raise ValueError(f'Benchmark source changed: {relative}')
+    if digest(Path(__file__).with_name('resumable_terrain_store.py')) != contract['generator_sha256']['resumable_terrain_store.py']:
+        raise ValueError('Tile reader differs from pinned version')
+    if shutil.disk_usage(output).free < 8*1024**3:
+        raise RuntimeError('Insufficient disk reserve')
+    package=types.ModuleType('airground_benchmark')
+    package.__path__=[str(args.benchmark_package)]
+    sys.modules.setdefault('airground_benchmark',package)
+    from airground_benchmark.config.schema import SCHEMA_VERSION
+    from airground_benchmark.ground_truth import (GridOrigin, TraversabilityMetadata, TraversabilityGrid,
+        load_target_annotations, validate_traversability_npz)
+    from airground_benchmark.traversability import (RaycastTerrainGrid, FootprintSweepConfig,
+        sweep_ugv_footprint_over_terrain, build_reach_region, write_nav2_occupancy_grid,
+        _slope_from_height, _max_neighbor_height_delta)
+    from airground_benchmark.roi_analysis import component_report, annotation_roi
+    targets=load_target_annotations(args.targets)
+    if targets.scene_id!=contract['scene_id'] or digest(args.targets)!=contract['targets_sha256']:
+        raise ValueError('Target scene/hash differs from the sampled contract')
+    if any(t.verified for t in targets.instances):raise ValueError('Expected explicit unreviewed targets')
+    with dataset_lock(args.dataset):
+        store=TileStore(args.dataset,contract)
+        stage('stitch_and_readback')
+        arrays,stitch_evidence=stitch(store,output/'terrain')
+        contract_hash=store.contract_hash
+    grid=contract['grid'];shape=tuple(grid['shape']);res=grid['resolution_m']
+    metadata=TraversabilityMetadata(schema_version=SCHEMA_VERSION,scene_id=contract['scene_id'],frame='map',
+        origin=GridOrigin(x_m=grid['origin_xy_m'][0],y_m=grid['origin_xy_m'][1],z_m=0),
+        resolution_m=res,shape=shape,generator='private-physx-full-map-diagnostic',generator_version='v1')
+    atomic_json(output/'terrain-metadata.json',metadata.model_dump(mode='json'))
+    stage('global_derivative_and_seam_check')
+    seam=np.zeros(shape,dtype=bool)
+    for r in range(grid['tile_cells'],shape[0],grid['tile_cells']):seam[r-1:r+1,:]=True
+    for c in range(grid['tile_cells'],shape[1],grid['tile_cells']):seam[:,c-1:c+1]=True
+    derivatives={}
+    for name,compute in [('slope_rad',lambda:_slope_from_height(arrays['height'],res)),
+                         ('step_height_m',lambda:_max_neighbor_height_delta(arrays['height']))]:
+        expected=compute().astype(np.float32)
+        delta=np.abs(expected-arrays[name]);bad=delta>1e-5
+        derivatives[name]={'max_abs_error':float(delta.max()),'outside_tolerance':int(bad.sum()),
+                           'seam_outside_tolerance':int(bad[seam].sum()),'tolerance':1e-5}
+        if bad.any():raise ValueError(f'Global derivative mismatch: {name}')
+        del expected,delta,bad
+    del seam
+    terrain=RaycastTerrainGrid(metadata=metadata,**arrays,obstacle_band_m=(.05,1.))
+    config=FootprintSweepConfig(max_step_height_m=.05)
+    stage('global_footprint_sweep')
+    sweep=sweep_ugv_footprint_over_terrain(terrain,config)
+    stage('global_reach_clearance_and_components')
+    reach=build_reach_region(sweep.traversable_mask,resolution_m=res,clearance_margin_m=.1075,
+                             footprint_width_m=.430,connectivity=8)
+    if np.any(reach.reach_mask.astype(bool)&~sweep.traversable_mask):
+        raise ValueError('Reach escaped footprint mask')
+    stage('independent_real_window_comparison')
+    references=[]
+    for index in (0,1):
+        ref_path=args.reference_dir/f'window-{index}-reference.npz'
+        ref_meta=TraversabilityMetadata.model_validate_json((args.reference_dir/f'window-{index}-metadata.json').read_text())
+        if ref_meta.scene_id!=metadata.scene_id or ref_meta.resolution_m!=res:
+            raise ValueError('Reference window scene/resolution mismatch')
+        row=round((ref_meta.origin.y_m-metadata.origin.y_m)/res)
+        col=round((ref_meta.origin.x_m-metadata.origin.x_m)/res)
+        rows,cols=ref_meta.shape
+        with np.load(ref_path,allow_pickle=False) as data:
+            ref_arrays={key:data[key].astype(FIELDS[key]) for key in FIELDS}
+        comparisons={}
+        for key,left in ref_arrays.items():
+            right=arrays[key][row:row+rows,col:col+cols]
+            margin=1 if key in ('slope_rad','step_height_m') else 0
+            inner=(slice(margin,-margin or None),slice(margin,-margin or None))
+            delta=np.abs(left[inner].astype(float)-right[inner].astype(float))
+            comparisons[key]={'outside_tolerance':int((delta>1e-5).sum()),'max_abs_error':float(delta.max()),'excluded_border_cells':margin}
+        ref_terrain=RaycastTerrainGrid(metadata=ref_meta,**ref_arrays,obstacle_band_m=(.05,1.))
+        ref_sweep=sweep_ugv_footprint_over_terrain(ref_terrain,config)
+        ref_reach=build_reach_region(ref_sweep.traversable_mask,resolution_m=res,clearance_margin_m=.1075,connectivity=8)
+        # Local image boundaries are blocked by the footprint sweep: omit a 12-cell boundary band.
+        for key,left,right in [('footprint',ref_sweep.traversable_mask,sweep.traversable_mask),
+                               ('reach',ref_reach.reach_mask,reach.reach_mask)]:
+            actual=right[row:row+rows,col:col+cols]
+            comparisons[key]={'outside_tolerance':int(np.count_nonzero(left[12:-12,12:-12]!=actual[12:-12,12:-12])),
+                              'excluded_border_cells':12}
+        references.append({'reference_npz_sha256':digest(ref_path),'window':index,'comparisons':comparisons})
+    reference_pass=all(item['outside_tolerance']==0 for ref in references for item in ref['comparisons'].values())
+    stage('target_geometric_coverage')
+    roi=annotation_roi(targets,resolution_m=res)
+    if roi['shape']!=list(shape) or not np.allclose(roi['origin_xy_m'],grid['origin_xy_m'],atol=1e-9,rtol=0):
+        raise ValueError('Annotation ROI differs from sampled grid')
+    # component_report retains the 31-instance gate for Retro only; new scenes
+    # use their own Table A.3 classes and the hash-pinned annotation manifest.
+    coverage=component_report(targets,metadata,sweep.traversable_mask,reach.reach_component)
+    coverage['purpose']='unreviewed_full_fine_geometric_candidate_only'
+    coverage['roi']=roi
+    coverage['resolution_note']='0.05 m full ROI; 0.1075 m clearance on footprint mask, 8-connected reach labels'
+    for target in coverage['targets']:
+        target['geometric_candidate_in_selected_component']=target.pop('eligible_in_selected_component')
+        target['eligible_in_selected_component']=False
+        target['requires_binding_review']=True
+        target['formal_gt_approved']=False
+    selected=coverage['selected_component']
+    atomic_json(output/'component-report.unreviewed.json',coverage)
+    stage('export_diagnostic_maps')
+    exports={}
+    for name,mask,component in [('footprint',sweep.traversable_mask,sweep.component),
+                               ('reach',reach.reach_mask,reach.reach_component)]:
+        destination=output/name;destination.mkdir()
+        data={'height':arrays['height'],'normal':arrays['normal'],'mask':mask.astype(np.uint8),
+              'component':component.astype(np.int32),'cost':sweep.cost}
+        npz=destination/f'{name}.npz'
+        np.savez_compressed(npz,**data)
+        export_meta=metadata.model_copy(update={'npz_sha256':digest(npz)})
+        # JSON is valid YAML and keeps all canonical metadata fields.
+        atomic_json(destination/f'{name}.metadata.yaml',export_meta.model_dump(mode='json'))
+        validation=validate_traversability_npz(npz,export_meta)
+        occupancy=write_nav2_occupancy_grid(TraversabilityGrid(metadata=export_meta,height=arrays['height'],
+                    mask=data['mask'],component=data['component'],cost=sweep.cost),destination,stem=f'{name}.unreviewed')
+        exports[name]={'validation':validation,'nav2':occupancy.summary(),'npz_sha256':digest(npz)}
+        del data
+    # The selected candidate map is explicitly labelled unreviewed; all component IDs stay local to this map.
+    selected_mask=(reach.reach_component==selected).astype(np.uint8)
+    nav_selected=write_nav2_occupancy_grid(TraversabilityGrid(metadata=metadata,height=arrays['height'],mask=selected_mask,
+        component=np.where(selected_mask,0,-1).astype(np.int32),cost=sweep.cost),output/'selected',stem='selected.unreviewed')
+    np.savez_compressed(output/'preview.npz',height=arrays['height'][::4,::4],
+        obstacle=arrays['obstacle_mask'][::4,::4],support=arrays['support_mask'][::4,::4],
+        footprint=sweep.traversable_mask[::4,::4],reach=reach.reach_mask[::4,::4],
+        component=reach.reach_component[::4,::4],selected=selected_mask[::4,::4])
+    stage('final_manifest')
+    files={str(p.relative_to(output)).replace('\\','/'): {'sha256':digest(p),'bytes':p.stat().st_size}
+           for p in output.rglob('*') if p.is_file() and p.name!='progress.json'}
+    selected_info=next(c for c in coverage['components'] if c['component_id']==selected)
+    report={'status':'passed' if reference_pass else 'failed','scope':'private_diagnostic_full_map_not_formal_gt',
+        'input_dataset':str(args.dataset),'contract_sha256':contract_hash,'scene_sha256':contract['scene_sha256'],
+        'source_sha256':{'postprocess_terrain_tiles.py':digest(Path(__file__)),
+                         'traversability.py':digest(args.benchmark_package/'traversability.py')},
+        'targets_sha256':digest(args.targets),'stitch':stitch_evidence,'derivatives':derivatives,
+        'independent_real_window_comparison':references,'reference_comparison_passed':reference_pass,
+        'grid':grid,'footprint_config':asdict(config),'terrain_summary':terrain.summary(),
+        'footprint_summary':sweep.summary(),'reach_summary':reach.summary(),'selected_component':selected_info,
+        'exports':exports,'selected_nav2':nav_selected.summary(),'files':files,
+        'elapsed_s':time.monotonic()-started,'full_diagnostic_map_generated':True,
+        'formal_gt_approved':False,'formal_episode_count':0,
+        'limitations':['Uses actual PhysX data but postprocessing itself does not run robot dynamics.',
+          'No teacher map comparison or human target review; geometry candidates are not scoring eligible.',
+          'Reach labels use existing 8-connectivity; live navigation and corner-clearance validation remain pending.',
+          'Reference-window comparisons exclude local boundary influence; no full monolithic raycast reference.',
+          'z=0 support plane and existing collider approximations retained from sampled scene.']}
+    atomic_json(output/'report.json',report)
+    stage('complete' if reference_pass else 'reference_comparison_failed')
+    gc.collect()
+    return report
+
+
+def main() -> int:
+    parser=argparse.ArgumentParser(description=__doc__)
+    for name in ('dataset','output','benchmark-package','targets','reference-dir'):
+        parser.add_argument('--'+name,type=Path,required=True)
+    args=parser.parse_args()
+    if args.output.exists():
+        parser.error('Refusing an existing output directory; previous results must remain unchanged')
+    logging.basicConfig(level=logging.INFO,format='%(asctime)s %(message)s')
+    try:
+        report=run(args)
+        return 0 if report['status']=='passed' else 1
+    except Exception as error:
+        logging.exception('Postprocessing failed')
+        if args.output.exists():
+            atomic_json(args.output/'report.json',{'status':'failed','error':str(error),'formal_gt_approved':False})
+        return 1
+
+
+if __name__=='__main__':
+    raise SystemExit(main())
diff --git a/scripts/preflight_scene_usd.py b/scripts/preflight_scene_usd.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed5d2771b2e261cefa8569d142a8dd8b7681f4fd
--- /dev/null
+++ b/scripts/preflight_scene_usd.py
@@ -0,0 +1,74 @@
+"""Read-only USD and candidate-coordinate audit; requires pxr, not SimulationApp."""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import math
+
+
+def main():
+    from pxr import Usd, UsdGeom, UsdUtils, Sdf
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--scene',type=Path,required=True)
+    parser.add_argument('--targets',type=Path,required=True)
+    parser.add_argument('--candidates',type=Path,required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    args=parser.parse_args()
+    if args.output.exists():raise RuntimeError('Refusing to replace an existing preflight')
+    sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+    targets=json.loads(args.targets.read_text(encoding='utf-8-sig'))
+    candidates=json.loads(args.candidates.read_text(encoding='utf-8-sig'))
+    if targets['scene_id']!=candidates['scene_id']:raise ValueError('Cross-scene input')
+    stage=Usd.Stage.Open(str(args.scene.resolve(strict=True)))
+    if not stage:raise RuntimeError('USD stage did not open')
+    bounds=UsdGeom.BBoxCache(Usd.TimeCode.Default(),['default','render'])
+    by_path={c['prim_path']:c for c in candidates['candidates']}
+    layers,assets,unresolved=UsdUtils.ComputeAllDependencies(str(args.scene))
+    unresolved_attrs=[]
+    for prim in stage.Traverse():
+        for attr in prim.GetAttributes():
+            if attr.GetTypeName() not in (Sdf.ValueTypeNames.Asset,Sdf.ValueTypeNames.AssetArray):continue
+            value=attr.Get()
+            values=[value] if isinstance(value,Sdf.AssetPath) else value or []
+            for asset in values:
+                if asset.path and not asset.resolvedPath:
+                    unresolved_attrs.append({'prim':str(prim.GetPath()),'attribute':attr.GetName(),'asset':asset.path})
+    rows=[]
+    for target in targets['instances']:
+        path=target.get('usd_prim_path');row={'instance_id':target['instance_id'],'prim_path':path,
+            'human_verified':target['verified'],'status':'unbound'}
+        if path:
+            prim=stage.GetPrimAtPath(path)
+            if not prim:row['status']='missing_prim'
+            else:
+                box=bounds.ComputeWorldBound(prim).ComputeAlignedRange()
+                center=list(box.GetMidpoint());size=list(box.GetSize())
+                if box.IsEmpty() or not all(math.isfinite(v) for v in center+size):row['status']='invalid_bounds'
+                else:
+                    candidate=by_path.get(path)
+                    errors=[abs(a-b) for a,b in zip(center+size,candidate['center_xyz_m']+candidate['size_xyz_m'])] if candidate else None
+                    row.update(center_xyz_m=center,size_xyz_m=size,candidate_max_error_m=max(errors) if errors else None,
+                        status='matches_export' if errors is not None and max(errors)<=.02 else 'candidate_mismatch')
+        rows.append(row)
+    roots=[];cache=UsdGeom.XformCache()
+    for path in ['/World','/World/stage']:
+        prim=stage.GetPrimAtPath(path)
+        if prim:
+            roots.append({'path':path,'local_to_world':[[float(v) for v in row] for row in cache.GetLocalToWorldTransform(prim)]})
+    result={'scene_id':targets['scene_id'],'scope':'offline USD dependency/coordinate diagnostic, not PhysX or human approval',
+        'usd_version':Usd.GetVersion(),'scene':str(args.scene),'scene_sha256':sha(args.scene),
+        'targets_sha256':sha(args.targets),'candidates_sha256':sha(args.candidates),
+        'meters_per_unit':UsdGeom.GetStageMetersPerUnit(stage),'up_axis':UsdGeom.GetStageUpAxis(stage),
+        'root_transforms':roots,'prim_count':sum(1 for _ in stage.Traverse()),
+        'layer_count':len(layers),'asset_count':len(assets),'unresolved':list(unresolved),'targets':rows,
+        'unresolved_asset_attributes':unresolved_attrs,
+        'formal_accepted':False}
+    result['passed']=bool(result['meters_per_unit']==1 and result['up_axis']=='Z' and not unresolved
+        and all(r['status'] in ('matches_export','unbound') for r in rows))
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(result,indent=2),encoding='utf-8')
+    print(json.dumps({k:v for k,v in result.items() if k not in ('targets','root_transforms','unresolved','unresolved_asset_attributes')},indent=2))
+    return 0 if result['passed'] else 2
+
+
+if __name__=='__main__':raise SystemExit(main())
diff --git a/scripts/prepare_scene_gt.py b/scripts/prepare_scene_gt.py
new file mode 100644
index 0000000000000000000000000000000000000000..18a151ecfa607273c6f6e1f9c9fc5832a8d48f67
--- /dev/null
+++ b/scripts/prepare_scene_gt.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Prepare handover S1-S3 from real local files; never synthesize reviewed GT.
+
+Run with the isolated Python environment containing usd-core and this package.
+Outputs are evaluator-private, under an ignored runs directory. S4-S10 require
+actual renderer/PhysX evidence and remain pending regardless of binding count.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "benchmark"))
+from airground_benchmark.ground_truth import (
+    UsdPrimCandidateManifest, bind_target_annotations_to_usd_prims,
+    build_target_review_ledger_template, canonical_target_annotations_json,
+    convert_rayfronts_bbox_annotations,
+)
+from airground_benchmark.roi_analysis import annotation_roi
+from airground_benchmark.scenes import (
+    SCENE_IDS, SCENE_REVIEW_NOTES, EXTRA_USD_ALIASES, paper_classes, paper_class_key,
+)
+from airground_benchmark.task_catalog import build_task_catalog
+
+
+def write_json(path: Path, payload: object) -> None:
+    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(4 * 1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def prepare(scene: str, output: Path) -> dict:
+    output.mkdir(parents=True, exist_ok=True)
+    source = ROOT / "RayFronts/rayfronts/annotations" / f"{scene}.json"
+    manifest = convert_rayfronts_bbox_annotations(
+        source, scene_id=scene, spawn_offset_xyz_m=(0., 0., 0.),
+        source_path=source.relative_to(ROOT).as_posix(),
+    )
+    (output / "targets.converted.json").write_text(canonical_target_annotations_json(manifest), encoding="utf-8")
+    classes = sorted({item.semantic_class for item in manifest.instances})
+    missing = sorted(c for c in paper_classes(scene) if paper_class_key(c) not in {paper_class_key(v) for v in classes})
+    summary = {
+        "scene_id": scene, "annotation_count": len(manifest.instances),
+        "source_annotation_sha256": sha256(source), "annotation_classes": classes,
+        "missing_paper_classes": missing, "notes": SCENE_REVIEW_NOTES.get(scene, ()),
+        "spawn_offset_xyz_m": [0, 0, 0],
+        "coordinate_status": "upstream world coordinates retained; runtime transform still needs verification",
+        "S1": "converted", "S2": "blocked_missing_usd", "S3": "blocked_missing_usd",
+        "S4_S10": "pending_real_RGB_review_PhysX_GT_and_UGV_runtime",
+        "verified_count": 0, "ground_reachable_count": 0,
+    }
+    # These are requested settings for a future real raycast, NOT measured GT.
+    write_json(output / "raycast.request.json", {
+        "scene_id": scene, "status": "not_executed", "roi": annotation_roi(manifest, margin_m=2, resolution_m=.05),
+        "raycast_z_m": [8, -2], "min_normal_z": .35, "obstacle_height_band_m": [.05, 1.0],
+        "support_plane_top_z_m": 0, "footprint_m": [.508, .430], "yaw_samples": 16,
+        "max_slope_deg": 15, "max_step_m": .05, "overhead_clearance_m": .5,
+        "reach_clearance_m": .1075, "connectivity": 8, "reach_window_m": [1.5, 8],
+        "component_selection": "target_coverage_desc_then_area_desc",
+        "visibility": {"camera_height_m": 1.2, "horizontal_fov_deg": 90, "range_m": [1.5, 8],
+                       "surface_points": 5, "min_visible_fraction": .2, "consecutive_frames": 5},
+        "note": "ROI from all annotation OBBs. Support-plane extents and runtime transform require scene review.",
+    })
+    scene_dir = ROOT / "AirStack/scenes" / scene
+    stages = sorted(p for p in scene_dir.glob("*.usd*") if p.suffix.lower() in (".usd", ".usda", ".usdc"))
+    if len(stages) == 1:
+        stage = stages[0]
+        aliases = output / "usd_aliases.json"
+        write_json(aliases, EXTRA_USD_ALIASES)
+        candidates_path = output / "prim_candidates.json"
+        command = [sys.executable, str(ROOT / "AirStack/simulation/isaac-sim/tools/export_target_prim_candidates.py"),
+                   "--stage", str(stage), "--output", str(candidates_path), "--scene-id", scene,
+                   "--root-prefix", "/World/stage", "--min-volume", "0.1", "--aliases", str(aliases)]
+        for name in classes:
+            command.extend(("--class", name))
+        with (output / "export.log").open("w", encoding="utf-8") as log:
+            result = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, check=False)
+        summary.update(usd_path=stage.relative_to(ROOT).as_posix(), usd_sha256=sha256(stage), export_exit_code=result.returncode)
+        write_json(output / "export.command.json", command)
+        candidate_payload = json.loads(candidates_path.read_text(encoding="utf-8")) if result.returncode == 0 else {}
+        if result.returncode == 0 and candidate_payload.get("candidates"):
+            prims = UsdPrimCandidateManifest.model_validate_json(candidates_path.read_text(encoding="utf-8"))
+            manifest, report = bind_target_annotations_to_usd_prims(manifest, prims, max_center_distance_m=3.)
+            write_json(output / "binding.report.json", report.model_dump(mode="json"))
+            summary.update(S2="exported_real_USD", S3="automatic_binding_pending_review",
+                           candidate_count=len(prims.candidates), bound_count=sum(bool(i.usd_prim_path) for i in manifest.instances))
+            summary["unbound_by_class"] = dict(Counter(i.semantic_class for i in manifest.instances if not i.usd_prim_path))
+            summary["ambiguous_count"] = report.ambiguous_count
+        elif result.returncode == 0:
+            summary.update(S2="real_USD_has_no_semantic_name_candidates", S3="blocked_no_candidates",
+                           candidate_count=0, bound_count=0,
+                           unbound_by_class=dict(Counter(i.semantic_class for i in manifest.instances)))
+        else:
+            summary.update(S2="export_failed_see_log", S3="blocked_export_failed")
+    elif len(stages) > 1:
+        summary.update(S2="blocked_multiple_USD_roots_require_selection", S3="blocked_ambiguous_stage")
+    (output / "targets.unreviewed.json").write_text(canonical_target_annotations_json(manifest), encoding="utf-8")
+    queue = {"scene_id": scene, "rows": [
+        {"instance_id": item.instance_id, "usd_prim_path": item.usd_prim_path,
+         "priority": index, "issues": ["real_RGB_review_required"] + ([] if item.usd_prim_path else ["unbound"])}
+        for index, item in enumerate(manifest.instances)
+    ]}
+    write_json(output / "review.queue.json", queue)
+    ledger = build_target_review_ledger_template(manifest, queue, review_version="scene-gt-handover-draft")
+    write_json(output / "review.ledger.template.json", ledger.model_dump(mode="json"))
+    catalog = build_task_catalog(manifest, source_annotation_path=str(output / "targets.unreviewed.json"))
+    write_json(output / "task_catalog.blocked.json", catalog.model_dump(mode="json"))
+    summary.update(task_count=catalog.task_count, blocked_task_count=catalog.blocked_count)
+    write_json(output / "summary.json", summary)
+    return summary
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scene", action="append", choices=SCENE_IDS)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    results = []
+    for scene in args.scene or SCENE_IDS[1:]:
+        result = prepare(scene, output / scene)
+        results.append(result)
+        print(json.dumps(result, ensure_ascii=False), flush=True)
+    write_json(output / "summary.json", {"status": "cpu_preparation_only", "scenes": results})
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/prepare_unreviewed_arrival_candidates.py b/scripts/prepare_unreviewed_arrival_candidates.py
new file mode 100644
index 0000000000000000000000000000000000000000..bc22b793c46cc0be1a5be70647ad659b94c49846
--- /dev/null
+++ b/scripts/prepare_unreviewed_arrival_candidates.py
@@ -0,0 +1,139 @@
+"""Export complete per-instance geometric candidates without approving any GT.
+
+This private diagnostic format intentionally differs from arrival_regions.npz:
+each instance has its own flat-index array, preserving overlapping regions.
+It is not a scoring input and has no visibility or human-review claims.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import logging
+from pathlib import Path
+import sys
+import time
+from typing import Any
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "benchmark"))
+from airground_benchmark.ground_truth import TraversabilityMetadata, load_target_annotations
+from airground_benchmark.roi_analysis import surface_window
+from airground_benchmark.scenes import is_paper_class
+
+
+def digest(path: Path) -> str:
+    checksum = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            checksum.update(chunk)
+    return checksum.hexdigest()
+
+
+def export_candidates(postprocess: Path, targets: Path, output: Path) -> dict[str, Any]:
+    started = time.monotonic()
+    if (postprocess / "INVALIDATED.json").exists():
+        raise ValueError("Map contract was invalidated; preserve evidence and resample before exporting candidates")
+    target_hash = digest(targets)
+    report = json.loads((postprocess / "report.json").read_text(encoding="utf-8"))
+    if report["status"] != "passed" or report["formal_gt_approved"]:
+        raise ValueError("Expected a completed, explicitly unreviewed diagnostic map")
+    if report["targets_sha256"] != target_hash:
+        raise ValueError("Target hash differs from the sampled scene contract")
+    manifest = load_target_annotations(targets)
+    if any(instance.verified for instance in manifest.instances):
+        raise ValueError("This tool accepts only wholly unreviewed annotations")
+    paper_instances = sorted((instance for instance in manifest.instances
+                              if is_paper_class(manifest.scene_id, instance.semantic_class)),
+                             key=lambda instance: instance.instance_id)
+    coverage_file = postprocess / "component-report.unreviewed.json"
+    if digest(coverage_file) != report["files"][coverage_file.name]["sha256"]:
+        raise ValueError("Component report hash mismatch")
+    coverage = json.loads(coverage_file.read_text(encoding="utf-8"))
+    if [instance.instance_id for instance in paper_instances] != sorted(item["instance_id"] for item in coverage["targets"]):
+        raise ValueError("Paper target identities differ from postprocessed component selection")
+    metadata_file = postprocess / "reach/reach.metadata.yaml"
+    if digest(metadata_file) != report["files"]["reach/reach.metadata.yaml"]["sha256"]:
+        raise ValueError("Reach metadata hash mismatch")
+    metadata = TraversabilityMetadata.model_validate_json(metadata_file.read_text(encoding="utf-8"))
+    if metadata.scene_id != manifest.scene_id or metadata.frame != manifest.frame or metadata.resolution_m != .05:
+        raise ValueError("Scene/frame/resolution mismatch")
+    if any(abs(value) > 1e-10 for instance in manifest.instances for value in instance.obb.orientation_rpy_rad[:2]):
+        raise ValueError("Planar OBB distance requires zero roll/pitch")
+    npz = postprocess / "reach/reach.npz"
+    map_hash = digest(npz)
+    if map_hash != report["exports"]["reach"]["npz_sha256"] or map_hash != metadata.npz_sha256:
+        raise ValueError("Reach map hash mismatch")
+    selected = int(report["selected_component"]["component_id"])
+    with np.load(npz, allow_pickle=False) as data:
+        allowed = (data["component"] == selected) & data["mask"].astype(bool)
+    if allowed.shape != tuple(metadata.shape) or not allowed.any():
+        raise ValueError("Invalid or empty selected component")
+    if manifest.instances and len(manifest.instances) > np.iinfo(np.uint16).max:
+        raise ValueError("Too many annotations for diagnostic overlap counter")
+    output.mkdir(parents=True, exist_ok=False)
+    arrays: dict[str, np.ndarray] = {}
+    overlap = np.zeros(metadata.shape, dtype=np.uint16)
+    entries = []
+    for index, instance in enumerate(paper_instances):
+        window, distances = surface_window(instance.obb, metadata, maximum=8.)
+        mask = allowed[window] & (distances >= 1.5) & (distances <= 8.)
+        rows, cols = np.nonzero(mask)
+        flat = (rows.astype(np.int64) + window[0].start) * metadata.shape[1] + cols + window[1].start
+        key = f"instance_{index:04d}_flat_cells"
+        arrays[key] = flat.astype(np.uint32 if allowed.size <= np.iinfo(np.uint32).max else np.uint64)
+        overlap[window] += mask.astype(np.uint16)
+        entries.append({"instance_id": instance.instance_id, "array_key": key, "cell_count": len(flat),
+                        "usd_prim_path": instance.usd_prim_path, "verified": False,
+                        "scoring_eligible": False, "visibility_checked": False,
+                        "distance_reference": "obb_surface_xy", "window_m": [1.5, 8.],
+                        "component_id": selected,
+                        "minimum_distance_m": float(distances[mask].min()) if len(flat) else None,
+                        "maximum_distance_m": float(distances[mask].max()) if len(flat) else None})
+        logging.info("Candidate %s: %d cells, human review pending", instance.instance_id, len(flat))
+    target = output / "geometric-candidates.unreviewed.npz"
+    np.savez_compressed(target, **arrays)
+    with np.load(target, allow_pickle=False) as saved:
+        for key, expected in arrays.items():
+            if not np.array_equal(saved[key], expected):
+                raise RuntimeError("Saved per-instance cells differ")
+            if len(expected) and (not np.all(allowed.reshape(-1)[expected]) or np.any(np.diff(expected.astype(np.int64)) <= 0)):
+                raise RuntimeError("Candidate cells escaped component or are duplicated")
+    if digest(targets) != target_hash:
+        raise RuntimeError("Input annotations changed during read-only export")
+    result = {"scope": "private_unreviewed_geometry_only_not_scoring_input", "scene_id": manifest.scene_id,
+              "formal_gt_approved": False, "status": "diagnostic_prepared",
+              "input_targets_sha256": target_hash, "input_map_sha256": map_hash,
+              "input_report_sha256": digest(postprocess / "report.json"),
+              "scene_contract_sha256": report["contract_sha256"],
+              "source_sha256": {"script": digest(Path(__file__)),
+                                  "roi_analysis.py": digest(Path(__file__).resolve().parents[1] / "benchmark/airground_benchmark/roi_analysis.py")},
+              "metadata": metadata.model_dump(mode="json"), "selected_component": selected,
+              "input_annotation_count": len(manifest.instances), "paper_target_count": len(paper_instances),
+              "entries": entries, "overlap_cells": int((overlap > 1).sum()),
+              "max_instances_per_cell": int(overlap.max()), "union_cells": int((overlap > 0).sum()),
+              "sum_instance_cells": int(sum(e["cell_count"] for e in entries)),
+              "output_sha256": digest(target), "readback_equal": True,
+              "input_targets_unchanged": True, "elapsed_s": time.monotonic() - started,
+              "limitations": ["Unbound and unreviewed geometry remains in this diagnostic only.",
+                              "No target annotation, verified/reachable flag, or visibility value was changed.",
+                              "This preserves overlapping candidates but does not change the official arrival format.",
+                              "Collision-profile or coordinate changes invalidate these candidates."]}
+    (output / "index.unreviewed.json").write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("postprocess", "targets", "output"):
+        parser.add_argument("--" + name, type=Path, required=True)
+    args = parser.parse_args()
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")
+    result = export_candidates(args.postprocess, args.targets, args.output)
+    logging.info("Saved %d candidate instances; %d overlapping cells", len(result["entries"]), result["overlap_cells"])
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/probe_full_map_nav2.py b/scripts/probe_full_map_nav2.py
new file mode 100644
index 0000000000000000000000000000000000000000..b68285416c6daf3c3883225388810c57230f38ed
--- /dev/null
+++ b/scripts/probe_full_map_nav2.py
@@ -0,0 +1,78 @@
+"""Read-only full-map adapter and bounded trajectory audit for Nav2 diagnostics."""
+from __future__ import annotations
+import hashlib
+import json
+import math
+from pathlib import Path
+import shutil
+from typing import Any
+import numpy as np
+
+
+def sha(path: Path) -> str:
+    value=hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda:stream.read(1024*1024),b''):value.update(chunk)
+    return value.hexdigest()
+
+
+def load_map(manifest_path: Path, output: Path, center: list[float], goals: list[list[float]]) -> dict[str,Any]:
+    from PIL import Image
+    import yaml
+    config=json.loads(manifest_path.read_text(encoding='utf-8'))
+    for name,entry in config['files'].items():
+        if sha(Path(entry['path']))!=entry['sha256']:raise ValueError(f'Full-map input hash mismatch: {name}')
+    source=Path(config['files']['map_yaml']['path'])
+    metadata=yaml.safe_load(source.read_text())
+    if metadata['resolution']!=.05 or metadata.get('negate',0)!=0:raise ValueError('Unexpected map encoding')
+    pgm=Path(config['files']['map_pgm']['path'])
+    if (source.parent/metadata['image']).resolve()!=pgm.resolve():raise ValueError('Map YAML image mismatch')
+    image=np.asarray(Image.open(pgm));mask=image[::-1]==254
+    if list(mask.shape)!=config['grid']['shape']:raise ValueError('Full-map dimensions differ')
+    origin=metadata['origin'][:2];res=metadata['resolution']
+    for label,point in [('spawn',center)]+[(f'goal-{i}',p) for i,p in enumerate(goals)]:
+        col,row=np.floor((np.asarray(point)-origin)/res).astype(int)
+        if not (3<=row<mask.shape[0]-3 and 3<=col<mask.shape[1]-3) or not mask[row-3:row+4,col-3:col+4].all():
+            raise ValueError(f'{label} lacks center-map clearance')
+    shutil.copy2(pgm,output/'local-map.pgm')
+    metadata['image']='local-map.pgm'
+    (output/'local-map.yaml').write_text(yaml.safe_dump(metadata,sort_keys=False),encoding='utf-8')
+    Image.fromarray(image).resize((1558,827),Image.Resampling.NEAREST).save(output/'local-map.png')
+    result={'method':'checksum-pinned full PhysX terrain, footprint sweep and selected reach component',
+        'scope':'unreviewed_full_map_diagnostic','resolution_m':res,'width':mask.shape[1],'height':mask.shape[0],
+        'origin':origin,'occupied_cells':int((~mask).sum()),'free_cells':int(mask.sum()),'unknown_cells':0,
+        'reviewed':False,'scene_sha256':config['scene_sha256'],'source_manifest_sha256':sha(manifest_path),
+        'source_map_pgm_sha256':sha(pgm),'config':config,
+        'limitations':'center-space conservative map; no formal GT/localization or global-route coverage acceptance'}
+    (output/'map-evidence.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
+    return result
+
+
+def geometry(output: Path, info: dict[str,Any], points: list[list[float]]) -> dict[str,Any]:
+    """Exact point-to-raw-obstacle-cell distance within 2 m; cap larger distances conservatively."""
+    from PIL import Image
+    res=info['resolution_m'];origin=np.asarray(info['origin']);xy=np.asarray(points)[:,:2]
+    raw=np.load(info['config']['files']['obstacle']['path'],mmap_mode='r')
+    support=np.load(info['config']['files']['support']['path'],mmap_mode='r')
+    indices=np.floor((xy-origin)/res).astype(int)
+    c0,r0=np.maximum(0,np.floor((xy.min(axis=0)-2-origin)/res).astype(int))
+    c1,r1=np.minimum([raw.shape[1],raw.shape[0]],np.ceil((xy.max(axis=0)+2-origin)/res).astype(int)+1)
+    blocked=np.asarray(raw[r0:r1,c0:c1])|~np.asarray(support[r0:r1,c0:c1])
+    cells=np.argwhere(blocked)
+    centers=origin+(cells[:,::-1]+[c0,r0]+.5)*res
+    minimum=2.
+    for offset in range(0,len(xy),64):
+        if not len(centers):break
+        delta=np.maximum(np.abs(xy[offset:offset+64,None,:]-centers[None,:,:])-res/2,0)
+        minimum=min(minimum,float(np.sqrt((delta*delta).sum(axis=2)).min()))
+    selected=np.asarray(Image.open(output/'local-map.pgm'))[::-1]
+    outside=occupied=center_map_blocked=0
+    for col,row in indices:
+        if not (0<=row<raw.shape[0] and 0<=col<raw.shape[1]):outside+=1;continue
+        occupied+=int(raw[row,col] or not support[row,col])
+        center_map_blocked+=int(selected[row,col]!=254)
+    return {'min_center_clearance_m':minimum,
+        'min_circumscribed_footprint_clearance_m':minimum-math.hypot(.508/2,.430/2),
+        'center_samples_on_obstacles':occupied,'center_samples_unknown_or_outside':outside,
+        'center_samples_outside_selected_map':center_map_blocked,
+        'clearance_method':'distance to raw obstacle/unsupported cell rectangles, conservatively capped at 2 m'}
diff --git a/scripts/probe_isaac_ros_bridge.py b/scripts/probe_isaac_ros_bridge.py
new file mode 100644
index 0000000000000000000000000000000000000000..8dd21ca617da64c391e4833204e15383f4d081fa
--- /dev/null
+++ b/scripts/probe_isaac_ros_bridge.py
@@ -0,0 +1,116 @@
+"""Real Isaac-to-ROS transport diagnostic; never actuates a robot or scores episodes."""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+from pathlib import Path
+import time
+from typing import Any
+
+
+def run_probe(world: Any, camera: Any, output: Path, seconds: float, run_id: str) -> dict:
+    import numpy as np
+    import rclpy
+    from builtin_interfaces.msg import Time
+    from geometry_msgs.msg import Twist
+    from rosgraph_msgs.msg import Clock
+    from sensor_msgs.msg import CameraInfo, Image
+    from std_msgs.msg import String
+
+    rclpy.init(args=[])
+    node = rclpy.create_node('raven_isaac_transport_probe', namespace='/ugv')
+    clock_pub = node.create_publisher(Clock, '/clock', 10)
+    image_pub = node.create_publisher(Image, '/ugv/diagnostic_camera/rgb', 5)
+    info_pub = node.create_publisher(CameraInfo, '/ugv/diagnostic_camera/camera_info', 5)
+    ack_pub = node.create_publisher(String, '/ugv/diagnostic/ack', 10)
+    report: dict = {'scope': 'actual_camera_clock_and_command_transport_only',
+                    'robot_actuated': False, 'benchmark_accepted': False, 'run_id': run_id,
+                    'clock_count': 0, 'commands': [], 'frames': [], 'challenge_received': False,
+                    'rclpy_file': rclpy.__file__}
+
+    def on_command(message: Twist) -> None:
+        report['commands'].append({'linear_x': message.linear.x, 'angular_z': message.angular.z,
+                                   'sim_time_s': float(world.current_time)})
+
+    def on_challenge(message: String) -> None:
+        if message.data == run_id:
+            report['challenge_received'] = True
+
+    node.create_subscription(Twist, '/ugv/cmd_vel', on_command, 10)
+    node.create_subscription(String, '/ugv/diagnostic/challenge', on_challenge, 10)
+
+    def stamp(value: float) -> Time:
+        ns = round(value * 1_000_000_000)
+        return Time(sec=ns // 1_000_000_000, nanosec=ns % 1_000_000_000)
+
+    def acknowledge(phase: str) -> None:
+        ack_pub.publish(String(data=json.dumps({
+            'run_id': run_id, 'phase': phase, 'challenge_received': report['challenge_received'],
+            'commands_received': len(report['commands']), 'robot_actuated': False,
+            'last_command': report['commands'][-1] if report['commands'] else None})))
+
+    started = time.monotonic()
+    last_image = last_ack = 0.0
+    last_sensor_frame = -1
+    report['start_sim_time_s'] = float(world.current_time)
+    try:
+        while time.monotonic() - started < seconds:
+            world.step(render=True)
+            rclpy.spin_once(node, timeout_sec=0)
+            clock_pub.publish(Clock(clock=stamp(float(world.current_time))))
+            report['clock_count'] += 1
+            now = time.monotonic()
+            sensor = camera.get_current_frame()
+            sensor_frame = int(sensor.get('rendering_frame', -1))
+            if now - last_image >= .2 and sensor_frame > last_sensor_frame:
+                rgba = np.asarray(camera.get_rgba())
+                if rgba.ndim == 3 and rgba.shape[2] == 4:
+                    rgb = rgba[..., :3].astype(np.uint8)
+                    if float(np.mean(np.max(rgb, axis=2) > 8)) >= .05:
+                        sensor_time = float(sensor.get('rendering_time', world.current_time))
+                        msg = Image()
+                        msg.header.stamp = stamp(sensor_time)
+                        msg.header.frame_id = 'raven_diagnostic_camera_optical'
+                        msg.height, msg.width = rgb.shape[:2]
+                        msg.encoding, msg.is_bigendian = 'rgb8', 0
+                        msg.step = msg.width * 3
+                        raw = rgb.tobytes()
+                        msg.data = raw
+                        image_pub.publish(msg)
+                        info = CameraInfo()
+                        info.header, info.width, info.height = msg.header, msg.width, msg.height
+                        info.distortion_model = 'plumb_bob'
+                        info.d = [0.] * 5
+                        info.k = camera.get_intrinsics_matrix().reshape(-1).tolist()
+                        info.r = np.eye(3).reshape(-1).tolist()
+                        info.p = np.column_stack((np.asarray(info.k).reshape(3, 3), np.zeros(3))).reshape(-1).tolist()
+                        info_pub.publish(info)
+                        report['frames'].append({'stamp_ns': msg.header.stamp.sec * 10**9 + msg.header.stamp.nanosec,
+                                                 'sensor_frame': sensor_frame, 'width': msg.width,
+                                                 'height': msg.height, 'sha256_rgb': hashlib.sha256(raw).hexdigest()})
+                        last_sensor_frame, last_image = sensor_frame, now
+            if now - last_ack >= .5:
+                acknowledge('running')
+                last_ack = now
+            time.sleep(.025)
+        report['end_sim_time_s'] = float(world.current_time)
+        kinds = {(round(c['linear_x'], 3), round(c['angular_z'], 3)) for c in report['commands']}
+        report['passed'] = (report['challenge_received'] and report['clock_count'] >= 30
+                            and len(report['frames']) >= 10
+                            and {(0., 0.), (.1, 0.), (0., .05)} <= kinds
+                            and report['commands'][-1]['linear_x'] == 0
+                            and report['commands'][-1]['angular_z'] == 0)
+        for _ in range(10):
+            acknowledge('finished')
+            rclpy.spin_once(node, timeout_sec=.05)
+        logging.info('ROS_BRIDGE_PROBE: passed=%s images=%s commands=%s',
+                     report['passed'], len(report['frames']), len(report['commands']))
+    finally:
+        report['wall_seconds'] = time.monotonic() - started
+        (output / 'ros-bridge.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+        node.destroy_node()
+        rclpy.shutdown()
+    if not report.get('passed'):
+        raise RuntimeError('ROS bridge did not meet bidirectional transport checks; inspect ros-bridge.json')
+    return report
