+            and record['plans'] and record['cmd_count']>10 and len(record['clouds'])>10
+            and all(record['costmaps'].get(n,{}).get('messages',0)>0 for n in ('map','global','local'))
+            and record['costmaps']['local']['max_lethal_cells']>0
+            and record['clock_backwards']==0 and record['max_clock_publishers']==1)
+        if full_map:
+            record['passed']=bool(record['passed'] and record['costmaps'].get('map',{}).get('matches_full_source_map')
+                and record['costmaps']['global']['width']==record['costmaps']['map']['width']
+                and record['costmaps']['global']['height']==record['costmaps']['map']['height']
+                and record['costmaps']['global']['origin']==record['costmaps']['map']['origin']
+                and abs(record['costmaps']['global']['resolution']-.05)<1e-8)
+            record['map_evidence_policy']='Full map/global binary snapshots once; local costmap live; existing lean subscriptions enabled'
+    except BaseException as exc:
+        record['passed']=False;record['error']=repr(exc)
+    finally:
+        if process.poll() is None:
+            os.killpg(process.pid,signal.SIGINT)
+            try: process.wait(timeout=20)
+            except subprocess.TimeoutExpired: os.killpg(process.pid,signal.SIGTERM)
+        log.close()
+        record['wall_seconds']=time.monotonic()-started
+        (args.output/'ros-evidence.json').write_text(json.dumps(record,indent=2))
+        result={key:record.get(key) for key in ('run_id','passed','exit_code','error','tour','costmaps','clock_backwards','max_clock_publishers')}
+        temporary=args.output/'done.tmp'
+        temporary.write_text(json.dumps(result,indent=2));temporary.replace(args.output/'done.json')
+        print(json.dumps(result),flush=True)
+        node.destroy_node();rclpy.shutdown()
+    return 0 if record['passed'] else 2
+
+
+if __name__=='__main__':
+    raise SystemExit(main())
diff --git a/scripts/probe_resumable_terrain.py b/scripts/probe_resumable_terrain.py
new file mode 100644
index 0000000000000000000000000000000000000000..aca5b84180c15a41e3c589d8126ff6c7ad245370
--- /dev/null
+++ b/scripts/probe_resumable_terrain.py
@@ -0,0 +1,96 @@
+"""Stream private real-PhysX terrain tiles to disk with restart validation."""
+from __future__ import annotations
+
+from dataclasses import asdict
+from datetime import datetime, timezone
+import logging
+from pathlib import Path
+import re
+import shutil
+import time
+from typing import Any
+
+import numpy as np
+from resumable_terrain_store import FIELDS, TileStore, atomic_json, dataset_lock, digest
+
+
+def run_stream(world: Any, output: Path, config: dict[str, Any], setup: dict[str, Any],
+               raycast: Any, terrain_config: Any) -> dict[str, Any]:
+    from airground_benchmark.config.schema import SCHEMA_VERSION
+    from airground_benchmark.ground_truth import GridOrigin, TraversabilityMetadata
+    from airground_benchmark.traversability import build_raycast_terrain_grid
+    stream = config['stream']
+    if not re.fullmatch(r'[a-z0-9-]+', stream['dataset']):
+        raise ValueError('Dataset must be a simple directory name')
+    root = output.parent/stream['dataset']
+    if not root.resolve().is_relative_to(output.parent.resolve()) or root == output:
+        raise ValueError('Dataset outside diagnostic logs directory')
+    if not 1 <= stream['budget_seconds'] <= 27000 or not 1 <= stream['max_new_tiles'] <= 10000:
+        raise ValueError('Invalid bounded sampling budget')
+    if shutil.disk_usage(output.parent).free < 8*1024**3:
+        raise RuntimeError('Less than 8 GiB disk reserve')
+    own_sources = {name:digest(Path(__file__).with_name(name)) for name in
+        ('probe_resumable_terrain.py','resumable_terrain_store.py','probe_tiled_terrain.py','probe_windows_scene_render.py')}
+    if own_sources != stream['generator_sha256']:
+        raise RuntimeError('Generator snapshot differs from pinned contract')
+    contract = {'format':'diagnostic-terrain-tiles-v1','scene_sha256':config['scene_sha256'],
+        'scene_id':config['scene_id'],'targets_sha256':config['targets_sha256'],
+        'source_sha256':config['source_sha256'],'generator_sha256':own_sources,
+        'setup':setup,'terrain_config':asdict(terrain_config),'grid':stream['grid'],
+        'global_postprocess_complete':False,'formal_gt_approved':False}
+    # Normalize tuples before equality checks against JSON loaded on resume.
+    import json
+    contract = json.loads(json.dumps(contract, allow_nan=False))
+    started = time.monotonic(); frozen_time = float(world.current_time)
+    with dataset_lock(root):
+        store = TileStore(root, contract)
+        skipped = len(store.completed); new_tiles = 0
+        stopped = 'all_tiles_sampled'
+        def progress(state: str) -> dict[str, Any]:
+            done = sum((v['tile']['core'][1]-v['tile']['core'][0])*
+                       (v['tile']['core'][3]-v['tile']['core'][2]) for v in store.completed.values())
+            total = int(np.prod(stream['grid']['shape']))
+            payload = {'updated_at':datetime.now(timezone.utc).isoformat(),'state':state,
+                'session':output.name,'dataset':str(root),'contract_sha256':store.contract_hash,
+                'completed_tiles':len(store.completed),'total_tiles':len(store.tiles),
+                'completed_cells':done,'total_cells':total,'fraction':done/total,
+                'skipped_existing_tiles':skipped,'new_tiles_this_session':new_tiles,
+                'sampling_complete':len(store.completed)==len(store.tiles),
+                'full_map_generated':False,'global_postprocess_complete':False,'formal_gt_approved':False,
+                'elapsed_sampling_wall_s':time.monotonic()-started}
+            atomic_json(root/'progress.json',payload)
+            atomic_json(output/'stream-progress.json',payload)
+            return payload
+        progress('sampling')
+        for tile in store.tiles:
+            if tile['id'] in store.completed:
+                continue
+            if (root/'STOP').exists():
+                stopped = 'operator_stop_file'; break
+            if new_tiles >= stream['max_new_tiles'] or time.monotonic()-started >= stream['budget_seconds']:
+                stopped = 'bounded_batch_complete'; break
+            if shutil.disk_usage(root).free < 8*1024**3:
+                raise RuntimeError('Disk reserve dropped below 8 GiB; completed tiles retained')
+            if float(world.current_time) != frozen_time:
+                raise RuntimeError('World advanced during static terrain sampling')
+            r0,r1,c0,c1 = tile['core']; hr0,hr1,hc0,hc1 = tile['halo']
+            grid = stream['grid']; res = grid['resolution_m']
+            metadata = TraversabilityMetadata(schema_version=SCHEMA_VERSION, scene_id=config['scene_id'],
+                frame='map',origin=GridOrigin(x_m=grid['origin_xy_m'][0]+hc0*res,
+                    y_m=grid['origin_xy_m'][1]+hr0*res,z_m=0.), resolution_m=res,
+                shape=(hr1-hr0,hc1-hc0),generator='native-physx-resumable-diagnostic',generator_version='v1')
+            tile_started = time.monotonic()
+            terrain = build_raycast_terrain_grid(metadata, raycast, terrain_config)
+            core=(slice(r0-hr0,r1-hr0),slice(c0-hc0,c1-hc0))
+            arrays = {key:getattr(terrain,key)[core].copy() for key in FIELDS}
+            store.commit(tile,arrays,{'session':output.name,'sample_wall_s':time.monotonic()-tile_started,
+                'frozen_sim_time_s':frozen_time})
+            del terrain, arrays
+            new_tiles += 1
+            state = progress('sampling')
+            logging.info('STREAM_TILE_COMMITTED: %s %d/%d', tile['id'],state['completed_tiles'],state['total_tiles'])
+        final = progress(stopped)
+        final['status'] = 'passed'
+        final['scope'] = 'bounded_durable_sampling_not_formal_map'
+        atomic_json(output/'stream-report.json',final)
+        return final
diff --git a/scripts/probe_ros_wsl_peer.py b/scripts/probe_ros_wsl_peer.py
new file mode 100644
index 0000000000000000000000000000000000000000..138c0c00226fe9829f9d44a957c040333ff626f3
--- /dev/null
+++ b/scripts/probe_ros_wsl_peer.py
@@ -0,0 +1,122 @@
+"""Bounded real ROS Humble peer for the Isaac transport probe; no navigation claim."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import logging
+from pathlib import Path
+import struct
+import time
+import zlib
+
+
+def save_rgb_png(path: Path, width: int, height: int, raw: bytes) -> None:
+    def chunk(kind: bytes, data: bytes) -> bytes:
+        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))
+    scanlines = b''.join(b'\0' + raw[y * width * 3:(y + 1) * width * 3] for y in range(height))
+    path.write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
+                     + chunk(b'IDAT', zlib.compress(scanlines)) + chunk(b'IEND', b''))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--run-id', required=True)
+    parser.add_argument('--timeout', type=float, default=650)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(message)s')
+    import rclpy
+    from geometry_msgs.msg import Twist
+    from rosgraph_msgs.msg import Clock
+    from sensor_msgs.msg import CameraInfo, Image
+    from std_msgs.msg import String
+
+    rclpy.init(args=[])
+    node = rclpy.create_node('raven_wsl_transport_probe', namespace='/ugv')
+    commands = node.create_publisher(Twist, '/ugv/cmd_vel', 10)
+    challenges = node.create_publisher(String, '/ugv/diagnostic/challenge', 10)
+    report: dict = {'scope': 'transport_only_no_robot_actuation', 'run_id': args.run_id,
+                    'clock_ns': [], 'images': [], 'camera_info': [], 'acks': [],
+                    'commands_sent': [], 'rclpy_file': rclpy.__file__}
+    first_clock_wall = None
+
+    def on_clock(message: Clock) -> None:
+        nonlocal first_clock_wall
+        if first_clock_wall is None:
+            first_clock_wall = time.monotonic()
+            logging.info('FIRST_REAL_SIM_CLOCK')
+        report['clock_ns'].append(message.clock.sec * 10**9 + message.clock.nanosec)
+
+    def on_image(message: Image) -> None:
+        raw = bytes(message.data)
+        if message.encoding != 'rgb8' or len(raw) != message.width * message.height * 3:
+            raise RuntimeError('Unexpected camera encoding or dimensions')
+        entry = {'stamp_ns': message.header.stamp.sec * 10**9 + message.header.stamp.nanosec,
+                 'width': message.width, 'height': message.height, 'frame_id': message.header.frame_id,
+                 'sha256_rgb': hashlib.sha256(raw).hexdigest()}
+        report['images'].append(entry)
+        if len(report['images']) == 1:
+            save_rgb_png(args.output / 'received-camera.png', message.width, message.height, raw)
+            logging.info('FIRST_REAL_CAMERA_IMAGE %sx%s', message.width, message.height)
+
+    def on_info(message: CameraInfo) -> None:
+        report['camera_info'].append({'stamp_ns': message.header.stamp.sec * 10**9 + message.header.stamp.nanosec,
+                                      'width': message.width, 'height': message.height, 'k': list(message.k)})
+
+    def on_ack(message: String) -> None:
+        ack = json.loads(message.data)
+        if ack.get('run_id') == args.run_id:
+            report['acks'].append(ack)
+
+    node.create_subscription(Clock, '/clock', on_clock, 10)
+    node.create_subscription(Image, '/ugv/diagnostic_camera/rgb', on_image, 5)
+    node.create_subscription(CameraInfo, '/ugv/diagnostic_camera/camera_info', on_info, 5)
+    node.create_subscription(String, '/ugv/diagnostic/ack', on_ack, 10)
+    (args.output / 'ready.json').write_text(json.dumps({'run_id': args.run_id, 'ready': True}))
+    started, last_publish = time.monotonic(), 0.
+    try:
+        while time.monotonic() - started < args.timeout:
+            rclpy.spin_once(node, timeout_sec=.05)
+            now = time.monotonic()
+            if now - last_publish >= .2:
+                elapsed = now - first_clock_wall if first_clock_wall is not None else -1
+                msg = Twist()
+                if 2 <= elapsed < 6:
+                    msg.linear.x = .1
+                elif 6 <= elapsed < 10:
+                    msg.angular.z = .05
+                commands.publish(msg)
+                challenges.publish(String(data=args.run_id))
+                report['commands_sent'].append([msg.linear.x, msg.angular.z])
+                last_publish = now
+            if report['acks'] and report['acks'][-1]['phase'] == 'finished':
+                break
+            if first_clock_wall is not None and now - first_clock_wall > 90:
+                break
+        clocks = report['clock_ns']
+        report['clock_monotonic'] = all(b >= a for a, b in zip(clocks, clocks[1:]))
+        report['clock_publisher_count'] = node.count_publishers('/clock')
+        report['topic_types'] = node.get_topic_names_and_types()
+        report['passed'] = (len(clocks) >= 30 and report['clock_monotonic'] and clocks[-1] > clocks[0]
+                            and len(report['images']) >= 10 and len(report['camera_info']) >= 10
+                            and any(a.get('challenge_received') and a.get('commands_received', 0) >= 10 for a in report['acks'])
+                            and report['acks'][-1]['phase'] == 'finished')
+    except Exception as error:
+        report['passed'], report['error'] = False, str(error)
+        logging.exception('WSL peer failed')
+    finally:
+        for _ in range(5):
+            commands.publish(Twist())
+            rclpy.spin_once(node, timeout_sec=.05)
+        report['wall_seconds'] = time.monotonic() - started
+        (args.output / 'report.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+        node.destroy_node()
+        rclpy.shutdown()
+    logging.info('WSL_PEER passed=%s clocks=%s images=%s', report.get('passed'), len(report['clock_ns']), len(report['images']))
+    return 0 if report.get('passed') else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/scripts/probe_target_confirmation.py b/scripts/probe_target_confirmation.py
new file mode 100644
index 0000000000000000000000000000000000000000..2db07ace3aa4d469e5e1805b8903a50ac238b761
--- /dev/null
+++ b/scripts/probe_target_confirmation.py
@@ -0,0 +1,162 @@
+"""Inspect one unreviewed target at an actual reached pose; never creates GT.
+
+The camera is a diagnostic observer oriented toward the known target, not a
+semantic detector or a validated physical camera mount. Raw PhysX hit records
+and RGB frames accompany the repository's per-pose visibility calculation.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+from pathlib import Path
+import sys
+import types
+from typing import Any
+
+
+def run_confirmation(world: Any, camera: Any, output: Path, config_path: Path,
+                     benchmark_path: Path) -> dict:
+    import numpy as np
+    import omni.physx
+    import omni.usd
+    from omni.isaac.dynamic_control import _dynamic_control
+    from PIL import Image
+    from pxr import Gf, Usd, UsdGeom
+
+    # Match the official visibility runner's lightweight benchmark import.
+    package = types.ModuleType('airground_benchmark')
+    package.__path__ = [str(benchmark_path)]
+    sys.modules.setdefault('airground_benchmark', package)
+    from airground_benchmark.ground_truth import (
+        TargetInstance, ConfirmationPose, RaycastConfirmationVisibilityConfig,
+        _raycast_confirmation_pose_metric, _obb_surface_distance_2d,
+    )
+    from airground_benchmark.isaac_los import make_isaac_physx_raycast_fn
+
+    config = json.loads(config_path.read_text(encoding='utf-8-sig'))
+    instance = TargetInstance.model_validate(config['target'])
+    if instance.verified or instance.ground_reachable != 'unknown':
+        raise ValueError('This diagnostic requires an unreviewed target with unknown reachability')
+    stage = omni.usd.get_context().get_stage()
+    prim = stage.GetPrimAtPath(instance.usd_prim_path)
+    if not prim.IsValid():
+        raise RuntimeError('Target prim does not exist in the loaded scene')
+    box = UsdGeom.BBoxCache(Usd.TimeCode.Default(), ['default', 'render']).ComputeWorldBound(prim).ComputeAlignedRange()
+    actual_center = np.array(box.GetMidpoint());actual_size = np.array(box.GetSize())
+    if np.linalg.norm(actual_center - np.array(config['candidate']['center_xyz_m'])) > .02:
+        raise RuntimeError('Loaded target bounds differ from the exported candidate')
+    query = omni.physx.get_physx_scene_query_interface()
+    class SnapshotQuery:
+        def raycast_all(self, origin: Any, direction: Any, distance: float, callback: Any) -> None:
+            # Copy callback-owned values immediately; static colliders may have
+            # an empty rigid-body path, so prefer the actual collision prim.
+            errors = []
+            def collect(hit: Any) -> bool:
+                try:
+                    value = (lambda k: hit.get(k)) if isinstance(hit,dict) else (lambda k: getattr(hit,k,None))
+                    path = str(value('collision') or value('rigid_body') or value('rigidBody') or '')
+                    if not path:
+                        raise RuntimeError('PhysX hit has no collider identity')
+                    return callback({'prim_path':path,'distance':float(value('distance'))})
+                except Exception as exc:
+                    errors.append(exc)
+                    return False
+            query.raycast_all(origin,direction,distance,collect)
+            if errors:
+                raise RuntimeError('Target visibility raycast callback failed') from errors[0]
+    raycast = make_isaac_physx_raycast_fn(SnapshotQuery())
+    dc = _dynamic_control.acquire_dynamic_control_interface()
+    body = dc.get_rigid_body('/World/ugv/base_link')
+    if not body or body == _dynamic_control.INVALID_HANDLE:
+        raise RuntimeError('Actual Jackal body is unavailable')
+    target = np.array(instance.obb.center_xyz_m)
+    visibility_config = RaycastConfirmationVisibilityConfig(
+        camera_height_m=1.2, min_distance_m=1.5, max_distance_m=8.,
+        horizontal_fov_rad=math.pi/2, min_visible_fraction=.2,
+        required_consecutive_frames=5, target_sample_count=5,
+        occlusion_epsilon_m=.001, ignored_prim_prefixes=('/World/ugv',))
+    usd_camera = UsdGeom.Camera(stage.GetPrimAtPath(camera.prim_path))
+    usd_camera.GetFocalLengthAttr().Set(18.)
+    usd_camera.GetHorizontalApertureAttr().Set(36.)
+    width, height = camera.get_resolution()
+    usd_camera.GetVerticalApertureAttr().Set(36.*height/width)
+    camera_transform = UsdGeom.Xformable(usd_camera)
+
+    def aim(eye: list[float], look: list[float]) -> None:
+        camera_transform.ClearXformOpOrder()
+        camera_transform.AddTransformOp().Set(Gf.Matrix4d().SetLookAt(
+            Gf.Vec3d(*eye), Gf.Vec3d(*look), Gf.Vec3d(0,0,1)).GetInverse())
+
+    def save_rgb(name: str) -> dict:
+        rgb = np.asarray(camera.get_rgba())[...,:3].astype(np.uint8)
+        if rgb.shape != (height,width,3) or rgb.std() < 1:
+            raise RuntimeError('Target camera frame is invalid')
+        path = output/name
+        Image.fromarray(rgb).save(path)
+        return {'file':name, 'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),
+                'sim_time_s':float(world.current_time),
+                'rendering_frame':int(camera.get_current_frame().get('rendering_frame',-1))}
+
+    report = {'scope':'single_unreviewed_target_diagnostic', 'passed':False,
+        'formal_episode':False, 'semantic_detection_performed':False,
+        'review_status':'pending_human_review', 'target':config['target'],
+        'candidate':config['candidate'], 'task_id':config['task_id'],
+        'config_sha256':hashlib.sha256(config_path.read_bytes()).hexdigest(),
+        'actual_candidate_bounds':{'center_xyz_m':actual_center.tolist(),'size_xyz_m':actual_size.tolist()},
+        'camera':'diagnostic observer at actual reached XY, z=1.2 above support plane, target-facing yaw',
+        'visibility_config':visibility_config.model_dump(mode='json'),
+        'distance_note':'Official visibility metric uses center distance; OBB surface distance is separately recorded for the reach window.',
+        'frames':[], 'images':[]}
+    try:
+        pose = dc.get_rigid_body_pose(body)
+        xy = [float(pose.p.x),float(pose.p.y)]
+        yaw = math.atan2(target[1]-xy[1],target[0]-xy[0])
+        aim([*xy,1.2],[xy[0]+math.cos(yaw),xy[1]+math.sin(yaw),1.2])
+        for _ in range(30): world.step(render=True)
+        for index in range(5):
+            for _ in range(12): world.step(render=True)
+            live = dc.get_rigid_body_pose(body)
+            if math.hypot(live.p.x-xy[0],live.p.y-xy[1]) > .05:
+                raise RuntimeError('Robot moved while acquiring stopped confirmation evidence')
+            hits = []
+            def traced(sender: Any, recipient: Any) -> Any:
+                result = raycast(sender, recipient)
+                hits.append({'origin':[sender.x_m,sender.y_m,sender.z_m],
+                    'endpoint':[recipient.x_m,recipient.y_m,recipient.z_m],
+                    'hits':[{'distance_m':h.distance_m,'prim_path':h.prim_path} for h in result]})
+                return result
+            # visible_fraction is an unused input for this PhysX metric; no
+            # synthetic confirmation region or reviewed manifest is created.
+            candidate_pose = ConfirmationPose(frame='map', position_xyz_m=(*xy,0.),
+                yaw_rad=yaw,distance_to_target_m=0.,visible_fraction=0.)
+            metric = _raycast_confirmation_pose_metric(0,candidate_pose,instance,traced,visibility_config).model_dump(mode='json')
+            metric.pop('consecutive_visible_frames')  # measure actual distinct frames below
+            image = save_rgb(f'target-confirmation-{index+1:02d}.png')
+            surface = _obb_surface_distance_2d(*xy,instance.obb)
+            report['images'].append(image)
+            report['frames'].append({'index':index, 'sim_time_s':float(world.current_time),
+                'robot_position_xyz_m':[live.p.x,live.p.y,live.p.z],
+                'camera_position_xyz_m':[*xy,1.2], 'camera_yaw_rad':yaw,
+                'obb_surface_distance_m':surface, 'metric':metric,'rays':hits})
+        aim([xy[0]-5,xy[1]-6,7.], [*target[:2],.8])
+        for _ in range(30): world.render()
+        report['images'].append(save_rgb('target-context.png'))
+        frames=report['frames']
+        gaps=[b['sim_time_s']-a['sim_time_s'] for a,b in zip(frames,frames[1:])]
+        frame_ids=[i['rendering_frame'] for i in report['images'][:5]]
+        target_hit_count=sum(h['prim_path'] and (h['prim_path']==instance.usd_prim_path or
+            h['prim_path'].startswith(instance.usd_prim_path+'/')) for f in frames for ray in f['rays'] for h in ray['hits'])
+        report['target_prim_hit_count']=target_hit_count
+        report['actual_consecutive_visible_frames']=5 if all(f['metric']['valid'] and
+            1.5<=f['obb_surface_distance_m']<=8. for f in frames) and all(0<g<=.15 for g in gaps) else 0
+        report['passed']=bool(report['actual_consecutive_visible_frames']==5 and
+            len(set(frame_ids))==5 and target_hit_count>0)
+        logging.info('TARGET_CONFIRMATION_RESULT passed=%s visible=%s',report['passed'],
+                     [f['metric']['visible_fraction'] for f in frames])
+    finally:
+        (output/'target-confirmation.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
+    if not report['passed']:
+        raise RuntimeError('Target confirmation incomplete; inspect actual ray and RGB evidence')
+    return report
diff --git a/scripts/probe_tiled_terrain.py b/scripts/probe_tiled_terrain.py
new file mode 100644
index 0000000000000000000000000000000000000000..23be5fd76944adeb2017a259128794ad8b927b96
--- /dev/null
