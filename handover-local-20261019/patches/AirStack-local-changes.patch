@@ -0,0 +1,121 @@
+"""CPU scene-selection safety checks; these do not exercise PhysX visibility."""
+from pathlib import Path
+import hashlib
+import importlib.util
+
+import pytest
+
+
+@pytest.fixture
+def runner(monkeypatch):
